{
  "expo": {
    "name": "CineFio",
    "slug": "cinefio",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O CineFio acessa suas fotos para voce escolher uma imagem de perfil.",
          "microphonePermission": false
        }
      ]
    ],
    "android": {
      "usesCleartextTraffic": true,
      "package": "com.brunoaxlrose.timeview"
    },
    "assetBundlePatterns": [
      "**/*"
    ]
  }
}
