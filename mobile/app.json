{
  "expo": {
    "name": "CineFio",
    "slug": "cinefiotime",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "runtimeVersion": "0.1.0",
    "updates": {
      "url": "https://u.expo.dev/1fee84ef-fad2-4cb5-b0d5-40a0912aea88"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O CineFio acessa suas fotos para voce escolher uma imagem de perfil.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ],
    "android": {
      "package": "com.brunoaxlrose.timeview"
    },
    "ios": {
      "bundleIdentifier": "com.brunoaxlrose.cinefio",
      "supportsTablet": true
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "1fee84ef-fad2-4cb5-b0d5-40a0912aea88"
      }
    },
    "owner": "brunoaxlroses-organization"
  }
}
