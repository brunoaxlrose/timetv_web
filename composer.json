{
    "name": "tvtime/clone",
    "description": "TV Time Clone in Laminas MVC",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "laminas/laminas-component-installer": "^3.3.0",
        "laminas/laminas-development-mode": "^3.12.0",
        "laminas/laminas-mvc": "^3.6.0",
        "laminas/laminas-db": "^2.19.0",
        "laminas/laminas-session": "^2.16.0",
        "laminas/laminas-router": "^3.12.0",
        "laminas/laminas-view": "^2.33.0",
        "laminas/laminas-servicemanager": "^3.22.0"
    },
    "autoload": {
        "psr-4": {
            "Application\\": "module/Application/src/"
        }
    },
    "config": {
        "allow-plugins": {
            "laminas/laminas-component-installer": true
        }
    }
}
