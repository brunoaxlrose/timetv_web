<?php
if (isset($_SESSION['user_id']) && (!isset($_SESSION['nome']) || !isset($_SESSION['sobrenome']))) {
    try {
        $pdo = new \PDO('pgsql:host=db;port=5432;dbname=tvtime_db', 'tvtime', 'tvtime_pass');
        $stmt = $pdo->prepare("SELECT nome, sobrenome, user_name FROM usuario WHERE id_usuario = :id LIMIT 1");
        $stmt->execute([':id' => $_SESSION['user_id']]);
        $u = $stmt->fetch(\PDO::FETCH_ASSOC);
        if ($u) {
            $_SESSION['nome'] = $u['nome'];
            $_SESSION['sobrenome'] = $u['sobrenome'];
            $_SESSION['username'] = $u['user_name'];
        }
    } catch (\Exception $e) {}
}
