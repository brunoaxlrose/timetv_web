                <button type="button" class="btn rounded-pill w-50 small fw-bold py-2 text-white" onclick="submitCreateList()" style="background-color: #7c4dff; border: none; font-size: 0.78rem;">Criar</button>
            </div>
        </div>
    </div>
</div>

<script>
    function promptCreateList() {
        const modal = new bootstrap.Modal(document.getElementById('createListModal'));
        document.getElementById('newListNameInput').value = '';
        modal.show();
    }

    function submitCreateList() {
        const name = document.getElementById('newListNameInput').value.trim();
        if (!name) {
            showToast('O nome da lista é obrigatório!', false);
            return;
        }

        const modalEl = document.getElementById('createListModal');
        const modal = bootstrap.Modal.getInstance(modalEl);

        $.post('/api/lists/create', { name: name }, function(res) {
            if (res.success) {
                modal.hide();
                showToast(res.message, true);
                loadPageContent('/dashboard', false);
            } else {
                showToast(res.message, false);
            }
        }).fail(function() {
            showToast('Erro ao criar lista.', false);
        });
    }

    function markNextEpisodeWatched(element, episodeId, itemId) {
        event.stopPropagation();
        event.preventDefault();
        
        // Show indicator on checking
        element.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span>';
        
        $.post('/api/episode', {
            episode_id: episodeId,
            item_id: itemId,
            status: 'watch'
        }, function(res) {
            if (res.success) {
                showToast('Episódio marcado como assistido!', true);
                // Dynamically refresh dashboard content
                loadPageContent('/dashboard', false);
            } else {
                showToast(res.message, false);
                element.innerHTML = '<i class="bi bi-check-lg"></i>';
            }
        }).fail(function() {
            showToast('Erro ao atualizar episódio.', false);
            element.innerHTML = '<i class="bi bi-check-lg"></i>';
        });
    }
</script>
