            <div class="mb-4">
                <input type="text" id="newListNameInput" class="form-control text-white border-0 py-2 px-3" style="background-color: #0c0c12; border-radius: 10px; font-size: 0.85rem;" placeholder="Nome da lista..." required>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-secondary rounded-pill w-50 small fw-bold py-2" data-bs-dismiss="modal" style="background-color: #2c2c3e; border: none; font-size: 0.78rem;">Cancelar</button>
                <button type="button" class="btn rounded-pill w-50 small fw-bold py-2 text-white" onclick="submitCreateList()" style="background-color: #7c4dff; border: none; font-size: 0.78rem;">Criar</button>
            </div>
        </div>
    </div>
</div>

<script>
    function promptCreateList() {
        const modal = new bootstrap.Modal(document.getElementById('createListModal'));
        document.getElementById('newListNameInput').value = '';
        modal.show();
    }

    function submitCreateList() {
        const name = document.getElementById('newListNameInput').value.trim();
        if (!name) {
            showToast('O nome da lista é obrigatório!', false);
            return;
        }

        const modalEl = document.getElementById('createListModal');
        const modal = bootstrap.Modal.getInstance(modalEl);
        const btn = modalEl.querySelector('button[onclick="submitCreateList()"]');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Criando...';
        }

        $.post('/api/lists/create', { name: name }, function(res) {
            if (res.success) {
                modal.hide();
                showToast(res.message, true);
                loadPageContent('/lists', false);
            } else {
                showToast(res.message, false);
                if (btn) {
                    btn.disabled = false;
                    btn.innerText = 'Criar';
                }
            }
        }).fail(function() {
            showToast('Erro ao criar lista.', false);
            if (btn) {
                btn.disabled = false;
                btn.innerText = 'Criar';
            }
        });
    }

    function deleteList(listId) {
        if (!confirm('Deseja realmente excluir esta lista? Todos os itens associados serão removidos.')) {
            return;
        }

        $.post('/api/lists/delete', { list_id: listId }, function(res) {
            if (res.success) {
                showToast(res.message, true);
                loadPageContent('/lists', false);
            } else {
                showToast(res.message, false);
            }
        }).fail(function() {
            showToast('Erro ao excluir lista.', false);
        });
    }

    function removeItemFromList(listId, itemId) {
        event.stopPropagation();
        event.preventDefault();

        $.post('/api/lists/remove', { list_id: listId, item_id: itemId }, function(res) {
            if (res.success) {
                showToast(res.message, true);
                loadPageContent('/lists', false);
            } else {
                showToast(res.message, false);
            }
        }).fail(function() {
            showToast('Erro ao remover item da lista.', false);
        });
    }
</script>
