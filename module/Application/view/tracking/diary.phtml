function getDateGroup($dateStr) {
    $timestamp = strtotime($dateStr);
    $diff = time() - $timestamp;
    $days = floor($diff / 86400);
    if ($days <= 0) {
        return "HOJE";
    } elseif ($days == 1) {
        return "ONTEM";
    } else {
        return "HÁ " . $days . " DIAS";
    }
}

