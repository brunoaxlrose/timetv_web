<script>
    window.handleSearchKeyUp = function(event) {
        if (event.key === 'Enter') {
            doPerformSearch();
        }
    };

    window.doPerformSearch = function() {
        const val = document.getElementById('globalSearchInput').value.trim();
        if (val === '') {
            clearSearch();
            return;
        }

        // Hide default discovery screen, show results loading placeholder
        document.getElementById('discoverDefaultSection').classList.add('d-none');
        document.getElementById('searchResultsSection').classList.remove('d-none');
        document.getElementById('searchResultsGrid').innerHTML = '<div class="col-12 text-center py-5"><div class="spinner-border text-accent" role="status" style="color: #a88beb;"><span class="visually-hidden">Carregando...</span></div></div>';

        // Load AJAX search response
        $.post('/search', { search: val }, function(responseData) {
            const $temp = $('<div>').html(responseData);
            const $newGrid = $temp.find('#searchResultsGrid');
            const $newCount = $temp.find('#searchResultCount');
            
            if ($newGrid.length) {
                $('#searchResultsGrid').html($newGrid.html());
            }
            if ($newCount.length) {
                $('#searchResultCount').text($newCount.text());
            }
            
            // Update browser URL silently without showing global loader overlay
            loadPageContent('/search?search=' + encodeURIComponent(val), false, false);
        }).fail(function() {
            showToast('Erro ao realizar busca.', false);
        });
    };

    window.clearSearch = function() {
        document.getElementById('globalSearchInput').value = '';
        loadPageContent('/search', false);
    };

    window.triggerRecentSearch = function(term) {
        document.getElementById('globalSearchInput').value = term;
        doPerformSearch();
    };

    window.clearRecentSearches = function() {
        $.getJSON('/search?clear_recent=1', function(res) {
            if (res.success) {
                loadPageContent('/search', false);
            }
        });
    };
</script>
