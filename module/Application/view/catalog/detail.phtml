                            $providersList[] = ['name' => $p, 'logo' => ''];
                        }
                    }
                }
                
                // Group / Deduplicate / Normalize Providers
                $normalized = [];
                foreach ($providersList as $prov) {
                    $name = trim($prov['name']);
                    $logo = $prov['logo'] ?? '';
                    
                    $targetName = $name;
                    
                    // Match normalization rules
                    if (stripos($name, 'Paramount') !== false) {
                        $targetName = 'Paramount+';
                    } elseif (stripos($name, 'Prime Video') !== false || stripos($name, 'Amazon') !== false) {
                        $targetName = 'Prime Video';
                    } elseif (stripos($name, 'Apple TV') !== false) {
                        $targetName = 'Apple TV+';
                    } elseif (stripos($name, 'Disney') !== false) {
                        $targetName = 'Disney+';
                    } elseif (stripos($name, 'HBO') !== false || strcasecmp($name, 'Max') === 0) {
                        $targetName = 'Max';
                    } elseif (stripos($name, 'Star+') !== false || stripos($name, 'Star Plus') !== false) {
                        $targetName = 'Star+';
                    } elseif (stripos($name, 'Claro') !== false) {
                        $targetName = 'Claro tv+';
                    } elseif (stripos($name, 'Netflix') !== false) {
                        $targetName = 'Netflix';
                    }
                    
                    // Keep the first logo found for the normalized name
                    if (!isset($normalized[$targetName])) {
                        $normalized[$targetName] = $logo;
                    } else {
                        if (empty($normalized[$targetName]) && !empty($logo)) {
                            $normalized[$targetName] = $logo;
                        }
                    }
                }
                
                // Rebuild providersList
                $providersList = [];
                foreach ($normalized as $name => $logo) {
                    $providersList[] = ['name' => $name, 'logo' => $logo];
