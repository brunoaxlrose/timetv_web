<div class="container-fluid p-0 min-vh-100 d-flex align-items-stretch">
    <!-- Left Pane: Features (Visible only on medium/large screens - 75% width) -->
    <div class="d-none d-md-flex col-md-7 col-xl-9 align-items-center justify-content-center p-5 text-white position-relative" 
         style="background: linear-gradient(135deg, #303C4B 0%, #505052 100%); border-right: 1px solid rgba(255,255,255,0.05);">
        
        <!-- Subtle background glowing shapes -->
        <div style="position: absolute; width: 300px; height: 300px; background: radial-gradient(circle, rgba(217, 153, 81, 0.15) 0%, transparent 70%); top: 10%; left: 10%; pointer-events: none;"></div>
        <div style="position: absolute; width: 400px; height: 400px; background: radial-gradient(circle, rgba(208, 204, 195, 0.1) 0%, transparent 70%); bottom: 10%; right: 10%; pointer-events: none;"></div>

        <!-- Features Card -->
        <div class="p-5 rounded-4 shadow-lg w-100" style="max-width: 500px; background-color: rgba(21, 21, 32, 0.6); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.05);">
            <h1 class="fw-bold mb-5 text-center" style="font-size: 2.5rem; letter-spacing: 1px; background: linear-gradient(135deg, #D99951 0%, #D0CCC3 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">CINEFIO</h1>
            
            <div class="d-flex flex-column gap-4">
                <!-- Feature 1 -->
                <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background-color: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255,255,255,0.03);">
                    <div class="d-flex align-items-center justify-content-center rounded-3" style="width: 48px; height: 48px; background-color: rgba(217, 153, 81, 0.15); color: #D99951; flex-shrink: 0;">
                        <i class="bi bi-tv fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1 text-white" style="font-size: 0.95rem;">Séries & Animes</h5>
                        <p class="text-gray mb-0 small" style="font-size: 0.8rem; color: #a5a5b4;">Acompanhe os episódios assistidos e os lançamentos de suas produções favoritas.</p>
                    </div>
                </div>

                <!-- Feature 2 -->
                <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background-color: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255,255,255,0.03);">
                    <div class="d-flex align-items-center justify-content-center rounded-3" style="width: 48px; height: 48px; background-color: rgba(208, 204, 195, 0.15); color: #D0CCC3; flex-shrink: 0;">
                        <i class="bi bi-film fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1 text-white" style="font-size: 0.95rem;">Filmes</h5>
                        <p class="text-gray mb-0 small" style="font-size: 0.8rem; color: #a5a5b4;">Organize seu catálogo de filmes e mantenha um histórico do que já assistiu.</p>
                    </div>
                </div>

                <!-- Feature 3 -->
                <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background-color: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255,255,255,0.03);">
                    <div class="d-flex align-items-center justify-content-center rounded-3" style="width: 48px; height: 48px; background-color: rgba(247, 215, 148, 0.15); color: #f7d794; flex-shrink: 0;">
                        <i class="bi bi-graph-up fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1 text-white" style="font-size: 0.95rem;">Estatísticas Detalhadas</h5>
                        <p class="text-gray mb-0 small" style="font-size: 0.8rem; color: #a5a5b4;">Veja gráficos incríveis sobre seu tempo gasto e hábitos de consumo de mídia.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Pane: Register Form (25% width on desktop/tablet) -->
    <div class="col-12 col-md-5 col-xl-3 d-flex flex-column justify-content-between p-4 p-md-5" style="background-color: #273343; min-height: 100vh;">
        <!-- Top Spacer for vertical centering on desktop -->
        <div class="d-none d-md-block" style="height: 20px;"></div>

        <!-- Form container (Centered) -->
        <div class="w-100 my-auto" style="max-width: 400px; margin: 0 auto;">
            <div class="text-center mb-4">
                <!-- TV Time Logo Icon -->
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 55px; height: 55px; font-size: 24px; background-color: #D99951; border-radius: 12px; box-shadow: 0 0 15px rgba(217, 153, 81, 0.4);">
                    <i class="bi bi-play-fill text-white fs-3"></i>
                </div>
                <h2 class="fw-bold text-white mb-2" style="font-size: 1.6rem;">Cadastre-se no <span style="color: #D99951;">CineFio</span></h2>
                <p class="text-gray small mb-0" style="color: #a5a5b4;">Acompanhe suas séries, animes e filmes favoritos</p>
            </div>

            <div id="authAlert" class="alert alert-danger d-none border-0 rounded-3 text-center small" role="alert" style="background-color: #ff3b30; color: white;"></div>

            <form id="authForm" action="/register" method="POST" class="mb-3">
                <div class="mb-2.5">
                    <label for="user_name" class="form-label text-gray small fw-bold text-uppercase mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px; color: #a5a5c0;">Nome de Usuário</label>
                    <div class="input-group">
                        <span class="input-group-text border-0" style="background-color: #1c1c1e !important; color: #D99951 !important;"><i class="bi bi-person"></i></span>
                        <input type="text" class="form-control border-0 text-white" id="user_name" name="user_name" required placeholder="ex: bruno123" style="background-color: #1c1c1e !important; font-size: 0.85rem; padding: 12px 10px;">
                    </div>
                </div>

                <div class="row g-2 mb-2.5">
                    <div class="col-6">
                        <label for="nome" class="form-label text-gray small fw-bold text-uppercase mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px; color: #a5a5c0;">Nome</label>
                        <div class="input-group">
                            <input type="text" class="form-control border-0 text-white" id="nome" name="nome" required placeholder="Ex: Bruno" style="background-color: #1c1c1e !important; font-size: 0.85rem; padding: 12px 10px;">
                        </div>
                    </div>
                    <div class="col-6">
                        <label for="sobrenome" class="form-label text-gray small fw-bold text-uppercase mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px; color: #a5a5c0;">Sobrenome</label>
                        <div class="input-group">
                            <input type="text" class="form-control border-0 text-white" id="sobrenome" name="sobrenome" required placeholder="Ex: Oliveira" style="background-color: #1c1c1e !important; font-size: 0.85rem; padding: 12px 10px;">
                        </div>
                    </div>
                </div>

                <div class="mb-2.5">
                    <label for="email" class="form-label text-gray small fw-bold text-uppercase mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px; color: #a5a5c0;">E-mail</label>
                    <div class="input-group">
                        <span class="input-group-text border-0" style="background-color: #1c1c1e !important; color: #D99951 !important;"><i class="bi bi-envelope"></i></span>
                        <input type="email" class="form-control border-0 text-white" id="email" name="email" required placeholder="seu@email.com" style="background-color: #1c1c1e !important; font-size: 0.85rem; padding: 12px 10px;">
                    </div>
                </div>
                
                <div class="mb-2.5">
                    <label for="password" class="form-label text-gray small fw-bold text-uppercase mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px; color: #a5a5c0;">Senha</label>
                    <div class="input-group">
                        <span class="input-group-text border-0" style="background-color: #1c1c1e !important; color: #D99951 !important;"><i class="bi bi-lock"></i></span>
                        <input type="password" class="form-control border-0 text-white" id="password" name="password" required placeholder="Crie uma senha (mín. 6 chars)" style="background-color: #1c1c1e !important; font-size: 0.85rem; padding: 12px 10px;">
                    </div>
                    <!-- Password Strength Progress Bar -->
                    <div class="progress mt-2" style="height: 6px; background-color: #2c2c3e; border-radius: 3px;">
                        <div id="passwordStrengthBar" class="progress-bar" role="progressbar" style="width: 0%; transition: width 0.3s, background-color 0.3s;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div id="passwordStrengthText" class="text-gray small mt-1" style="font-size: 0.68rem; font-weight: 500; color: #a5a5c0 !important;">Mínimo de 6 caracteres</div>
                </div>

                <div class="mb-4">
                    <label for="password_confirm" class="form-label text-gray small fw-bold text-uppercase mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px; color: #a5a5c0;">Confirmar Senha</label>
                    <div class="input-group">
                        <span class="input-group-text border-0" style="background-color: #1c1c1e !important; color: #D99951 !important;"><i class="bi bi-lock-fill"></i></span>
                        <input type="password" class="form-control border-0 text-white" id="password_confirm" name="password_confirm" required placeholder="Repita a senha" style="background-color: #1c1c1e !important; font-size: 0.85rem; padding: 12px 10px;">
                    </div>
                    <div id="passwordMatchText" class="small mt-1 d-none" style="font-size: 0.68rem; font-weight: 500; color: #a5a5c0 !important;"></div>
                </div>

                <button type="submit" class="btn w-100 py-3 rounded-pill fw-bold text-white d-flex align-items-center justify-content-center gap-2" style="background-color: #D99951; font-size: 0.85rem;">
                    <span id="btnSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                    <span>Criar Conta</span>
                </button>
            </form>

            <div class="text-center mt-3">
                <p class="mb-0 text-gray small" style="color: #a5a5b4;">Já tem uma conta? <a href="/login" class="text-decoration-none fw-bold" style="color: #D99951;">Entrar</a></p>
            </div>
        </div>

        <!-- Pinned Legible Footer (Pushed to bottom) -->
        <div class="text-center w-100 mt-4 pt-2.5" style="border-top: 1px solid rgba(255,255,255,0.06); padding-bottom: 5px;">
            <p class="mb-0" style="font-size: 0.85rem; color: var(--text-muted); font-weight: 500;">© CINEFIO 2026</p>
        </div>
    </div>
</div>

<script src="/js/app/auth/register.js"></script>
