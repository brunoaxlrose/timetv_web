<div class="container-fluid p-0 min-vh-100 d-flex align-items-stretch">
    <!-- Left Pane: Features (Visible only on medium/large screens - 75% width) -->
    <div class="d-none d-md-flex col-md-7 col-xl-9 align-items-center justify-content-center p-5 text-white position-relative" 
         style="background: linear-gradient(135deg, #0f0f15 0%, #1a1a2e 100%); border-right: 1px solid rgba(255,255,255,0.05);">
        
        <!-- Subtle background glowing shapes -->
        <div style="position: absolute; width: 300px; height: 300px; background: radial-gradient(circle, rgba(124, 77, 255, 0.15) 0%, transparent 70%); top: 10%; left: 10%; pointer-events: none;"></div>
        <div style="position: absolute; width: 400px; height: 400px; background: radial-gradient(circle, rgba(248, 165, 194, 0.1) 0%, transparent 70%); bottom: 10%; right: 10%; pointer-events: none;"></div>

        <!-- Features Card -->
        <div class="p-5 rounded-4 shadow-lg w-100" style="max-width: 500px; background-color: rgba(21, 21, 32, 0.6); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.05);">
            <h1 class="fw-bold mb-5 text-center" style="font-size: 2.5rem; letter-spacing: 1px; background: linear-gradient(135deg, #a88beb 0%, #f8a5c2 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">TIME VIEW</h1>
            
            <div class="d-flex flex-column gap-4">
                <!-- Feature 1 -->
                <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background-color: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255,255,255,0.03);">
                    <div class="d-flex align-items-center justify-content-center rounded-3" style="width: 48px; height: 48px; background-color: rgba(124, 77, 255, 0.15); color: #a88beb; flex-shrink: 0;">
                        <i class="bi bi-tv fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1 text-white" style="font-size: 0.95rem;">Séries & Animes</h5>
                        <p class="text-gray mb-0 small" style="font-size: 0.8rem; color: #a5a5b4;">Acompanhe os episódios assistidos e os lançamentos de suas produções favoritas.</p>
                    </div>
                </div>

                <!-- Feature 2 -->
                <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background-color: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255,255,255,0.03);">
                    <div class="d-flex align-items-center justify-content-center rounded-3" style="width: 48px; height: 48px; background-color: rgba(248, 165, 194, 0.15); color: #f8a5c2; flex-shrink: 0;">
                        <i class="bi bi-film fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1 text-white" style="font-size: 0.95rem;">Filmes</h5>
                        <p class="text-gray mb-0 small" style="font-size: 0.8rem; color: #a5a5b4;">Organize seu catálogo de filmes e mantenha um histórico do que já assistiu.</p>
                    </div>
                </div>

                <!-- Feature 3 -->
                <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background-color: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255,255,255,0.03);">
                    <div class="d-flex align-items-center justify-content-center rounded-3" style="width: 48px; height: 48px; background-color: rgba(247, 215, 148, 0.15); color: #f7d794; flex-shrink: 0;">
                        <i class="bi bi-graph-up fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1 text-white" style="font-size: 0.95rem;">Estatísticas Detalhadas</h5>
                        <p class="text-gray mb-0 small" style="font-size: 0.8rem; color: #a5a5b4;">Veja gráficos incríveis sobre seu tempo gasto e hábitos de consumo de mídia.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Pane: Login Form (25% width on desktop/tablet) -->
    <div class="col-12 col-md-5 col-xl-3 d-flex flex-column justify-content-between p-4 p-md-5" style="background-color: #08080a; min-height: 100vh;">
        <!-- Top Spacer for vertical centering on desktop -->
        <div class="d-none d-md-block" style="height: 40px;"></div>

        <!-- Form container (Centered) -->
        <div class="w-100 my-auto" style="max-width: 400px; margin: 0 auto;">
            <div class="text-center mb-4">
                <!-- TV Time Logo Icon -->
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 55px; height: 55px; font-size: 24px; background-color: #7c4dff; border-radius: 12px; box-shadow: 0 0 15px rgba(124, 77, 255, 0.4);">
                    <i class="bi bi-play-fill text-white fs-3"></i>
                </div>
                <h2 class="fw-bold text-white mb-2" style="font-size: 1.6rem;">Acesse sua Conta</h2>
                <p class="text-gray small mb-0" style="color: #a5a5b4;">Insira suas credenciais para acessar ao painel.</p>
            </div>

            <div id="authAlert" class="alert alert-danger d-none border-0 rounded-3 text-center small" role="alert" style="background-color: #ff3b30; color: white;"></div>

            <form id="authForm" action="/login" method="POST" class="mb-3">
                <div class="mb-3">
                    <label for="email" class="form-label text-gray small fw-bold text-uppercase mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px; color: #a5a5c0;">E-mail</label>
                    <div class="input-group">
                        <span class="input-group-text border-0" style="background-color: #1c1c1e !important; color: #a88beb !important;"><i class="bi bi-envelope"></i></span>
                        <input type="email" class="form-control border-0 text-white" id="email" name="email" required placeholder="seu@email.com" style="background-color: #1c1c1e !important; font-size: 0.85rem; padding: 12px 10px;">
                    </div>
                </div>
                
                <div class="mb-4">
                    <label for="password" class="form-label text-gray small fw-bold text-uppercase mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px; color: #a5a5c0;">Senha</label>
                    <div class="input-group">
                        <span class="input-group-text border-0" style="background-color: #1c1c1e !important; color: #a88beb !important;"><i class="bi bi-lock"></i></span>
                        <input type="password" class="form-control border-0 text-white" id="password" name="password" required placeholder="Sua senha" style="background-color: #1c1c1e !important; font-size: 0.85rem; padding: 12px 10px;">
                    </div>
                </div>

                <button type="submit" class="btn w-100 py-3 rounded-pill fw-bold text-white d-flex align-items-center justify-content-center gap-2" style="background-color: #7c4dff; font-size: 0.85rem;">
                    <span id="btnSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>Entrar</span>
                </button>
            </form>

            <div class="text-center mt-4">
                <p class="mb-0 text-gray small" style="color: #a5a5b4;">Não tem uma conta? <a href="/register" class="text-decoration-none fw-bold" style="color: #a88beb;">Cadastre-se</a></p>
            </div>
        </div>

        <!-- Pinned Legible Footer (Pushed to bottom) -->
        <div class="text-center w-100 mt-5 pt-3" style="border-top: 1px solid rgba(255,255,255,0.06); padding-bottom: 10px;">
            <p class="mb-0" style="font-size: 0.85rem; color: var(--text-muted); font-weight: 500;">© TIME VIEW 2026</p>
        </div>
    </div>
</div>

<script src="/js/app/auth/login.js"></script>
